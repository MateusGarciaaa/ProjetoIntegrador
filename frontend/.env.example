# URL base da API, incluindo /api/v1 (prefixo de todos os controllers).
#   Com o proxy do Vite (recomendado em desenvolvimento): /api/v1
#   Sem proxy: http://localhost:8080/api/v1 (exige CORS liberado no backend)
VITE_API_BASE_URL=/api/v1

# true = backend simulado em memória, sem precisar do Spring Boot rodando.
VITE_USE_MOCK_API=false

# Só no modo simulado: validade do token falso, em segundos (padrão igual ao backend: 86400).
# Use um valor pequeno (ex.: 60) para ver o logout automático acontecer.
VITE_MOCK_TOKEN_EXPIRES_IN=86400

# Só para o servidor de desenvolvimento (não vai para o navegador):
# para onde o Vite encaminha as chamadas a /api.
DEV_PROXY_TARGET=http://localhost:8080
