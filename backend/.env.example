# Copie para ".env" e ajuste. O arquivo ".env" NUNCA deve ser versionado (RNF23).
# Lido pelo Docker Compose (raiz) e pelo Spring Boot quando roda pela IDE.
# git mv env.example backend/.env.example

# --- Banco ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=churchhub
DB_USERNAME=churchhub
DB_PASSWORD=troque-esta-senha

# --- API ---
API_PORT=8080
# OBRIGATÓRIO, mínimo 32 caracteres. Gere um valor aleatório:
#   Git Bash / Linux / macOS:  openssl rand -base64 48
#   PowerShell:                [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Primeiro acesso ---
# Administrador criado na primeira subida, se o e-mail ainda não existir (senha com 8+ caracteres).
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Contas e dados fictícios para apresentação (senha pública!). Nunca use com dados reais.
#   administrador@ | secretario@ | pastor@ | tesoureiro@ | membro@ churchhub.local
DEMO_DATA_ENABLED=false
DEMO_PASSWORD=demo123

# --- pgAdmin (opcional, profile "tools") ---
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@churchhub.local
PGADMIN_PASSWORD=troque-esta-senha
